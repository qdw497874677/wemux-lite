{
  "name": "@wemux/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "npm run build --workspace @wemux/domain && npm run build --workspace @wemux/wire-protocol && tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/test/*.test.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@wemux/domain": "0.1.0",
    "@wemux/server-domain": "0.1.0",
    "@wemux/web-contract": "0.1.0",
    "@wemux/wire-protocol": "0.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
