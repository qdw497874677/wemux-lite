{
  "name": "@wemux/web-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connectors": {
      "types": "./dist/connectors.d.ts",
      "import": "./dist/connectors.js"
    },
    "./channels": {
      "types": "./dist/channels.d.ts",
      "import": "./dist/channels.js"
    },
    "./task-dispatch": {
      "types": "./dist/task-dispatch.d.ts",
      "import": "./dist/task-dispatch.js"
    },
    "./task-platform": {
      "types": "./dist/task-platform.d.ts",
      "import": "./dist/task-platform.js"
    },
    "./session-graph": {
      "types": "./dist/session-graph.d.ts",
      "import": "./dist/session-graph.js"
    },
    "./browser-host": {
      "types": "./dist/browser-host.d.ts",
      "import": "./dist/browser-host.js"
    },
    "./resource-write": {
      "types": "./dist/resource-write.d.ts",
      "import": "./dist/resource-write.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@wemux/domain": "0.1.0"
  }
}
